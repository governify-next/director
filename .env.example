// Service configuration
NODE_ENV=development
GOV_LOG_LEVEL=INFO
GOV_SERVICE_NAME=director
PORT=5906

# Internal service URLs
AUTHENTICATOR_SERVICE_URL=http://localhost:5900
REGISTRY_SERVICE_URL=http://localhost:5902
FETCHER_SERVICE_URL=http://localhost:5904
REPORTER_SERVICE_URL=http://localhost:5905

// Database URIs
MONGO_URI=mongodb://localhost:27017/governify-next
REDIS_URI=redis://localhost:6379

// JWT configuration
CLIENT_ID=director
CLIENT_SECRET=director_client_secret
JWT_SECRET=governify_next_secret_key
JWT_ISSUER=authenticator
JWT_AUDIENCE=governify-next

// BullMQ configuration
WORKER_CONCURRENCY=1
QUEUE_CLEANUP_INTERVAL=0
